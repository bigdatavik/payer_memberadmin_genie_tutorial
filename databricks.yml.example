# Databricks Asset Bundle - Genie Room (Payer Member Administration)
# Copy this file to databricks.yml and set your workspace host and CLI profile.
# Deploy to dev or staging: databricks bundle deploy --target dev | databricks bundle deploy --target staging
# Do not run the job from CI; run it manually in the workspace after deploy.

bundle:
  name: payer-memberadmin-genie-tutorial

workspace:
  host: https://YOUR_WORKSPACE.cloud.databricks.com
  profile: YOUR_CLI_PROFILE

variables:
  environment:
    description: "Environment (dev or staging)"
    default: staging

targets:
  dev:
    mode: development
    variables:
      environment: dev
    workspace:
      host: https://YOUR_WORKSPACE.cloud.databricks.com
      profile: YOUR_CLI_PROFILE
      root_path: /Workspace/Users/${workspace.current_user.userName}/.bundle/${bundle.name}/dev

  staging:
    mode: development
    default: true
    variables:
      environment: staging
    workspace:
      host: https://YOUR_WORKSPACE.cloud.databricks.com
      profile: YOUR_CLI_PROFILE
      root_path: /Workspace/Users/${workspace.current_user.userName}/.bundle/${bundle.name}/staging

resources:
  jobs:
    genie_memberadmin_setup:
      name: genie_memberadmin_setup_${var.environment}
      description: "Genie Room - Payer Member Administration (deploy only; run manually)"
      parameters:
        - name: environment
          default: ${var.environment}
      tasks:
        - task_key: run_genie_memberadmin_setup
          notebook_task:
            notebook_path: ./One_Notebook_Genie_Room_Setup.py
            base_parameters:
              environment: ${var.environment}
          timeout_seconds: 900
